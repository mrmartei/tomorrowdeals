{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access control.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "shop", "marketer", "customer"] },
        "name": { "type": "string" },
        "regionId": { "type": "string", "description": "Associated region for shops and customers." },
        "marketerId": { "type": "string", "description": "The marketer who referred this customer." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "name"]
    },
    "Country": {
      "title": "Country",
      "description": "Country definition.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Region": {
      "title": "Region",
      "description": "Region within a country.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "countryId": { "type": "string" }
      },
      "required": ["id", "name", "countryId"]
    },
    "Shop": {
      "title": "Shop",
      "description": "A shop located in a specific region.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "regionId": { "type": "string" },
        "ownerUid": { "type": "string", "description": "The UID of the user who owns this shop." }
      },
      "required": ["id", "name", "regionId", "ownerUid"]
    },
    "Product": {
      "title": "Product",
      "description": "Commodity product with retail and wholesale pricing.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "retailPrice": { "type": "number" },
        "wholesalePrice": { "type": "number" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" }
      },
      "required": ["id", "name", "retailPrice", "wholesalePrice"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User profiles."
    },
    "/countries/{countryId}": {
      "schema": "Country",
      "description": "List of countries."
    },
    "/regions/{regionId}": {
      "schema": "Region",
      "description": "List of regions."
    },
    "/shops/{shopId}": {
      "schema": "Shop",
      "description": "List of shops."
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "List of products."
    }
  }
}
